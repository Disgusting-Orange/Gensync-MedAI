# GenSync-Cache Environment Configuration
# Copy this file to .env for local development

AWS_REGION=ap-south-1
EMERGENCY_NUMBER=112
COSINE_THRESHOLD=0.92

# DynamoDB Configuration
DYNAMODB_TABLE_CACHE=gensync_semantic_query_cache
DYNAMODB_TABLE_CENTROIDS=gensync_cluster_centroids
DYNAMODB_TABLE_AUDIT=gensync_triage_audit_log
DYNAMODB_TABLE_REVIEW_QUEUE=gensync_slm_review_queue

# SNS Notification Topic (Emergency operational alerts)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:471597060887:ClinicalEmergencyTriage

# Optional Tier-2 SLM Endpoint or Mock flag
ENABLE_TIER2_SLM=false
SLM_MODEL_PATH=models/smollm-135m-instruct.q4_k_m.gguf
